{
    "name": "spryker-community/search-ranking",
    "type": "library",
    "description": "Data-driven search ranking for Spryker: business-signal metrics (impressions, sales, ...) with configurable weights and normalization formulas, a Zed management UI, data import, and a normalization cron - the foundation for function_score based result ranking.",
    "license": "MIT",
    "keywords": [
        "spryker",
        "elasticsearch",
        "search",
        "ranking",
        "function-score",
        "business-signals"
    ],
    "require": {
        "php": ">=8.2",
        "spryker/data-import": "^1.18.0",
        "spryker/event": "^2.2.0",
        "spryker/gui": "^3.30.0 || ^5.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/product": "^6.0.0",
        "spryker/product-page-search": "^3.0.0",
        "spryker/product-page-search-extension": "^1.3.0",
        "spryker/propel-orm": "^1.16.0",
        "spryker/transfer": "^3.25.0",
        "symfony/console": "^6.0.0 || ^7.0.0",
        "symfony/expression-language": "^6.0.0 || ^7.0.0",
        "symfony/form": "^6.0.0 || ^7.0.0",
        "symfony/http-foundation": "^6.0.0 || ^7.0.0",
        "symfony/validator": "^6.0.0 || ^7.0.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.0.0",
        "phpunit/phpunit": "^10.0.0 || ^11.0.0"
    },
    "autoload": {
        "psr-4": {
            "SprykerCommunity\\": "src/SprykerCommunity/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerCommunityTest\\": "tests/SprykerCommunityTest/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "homepage": "https://github.com/andrebarthelmeshellmuth/spryker-search-ranking",
    "authors": [
        {
            "name": "Andre Barthelmes",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/andrebarthelmeshellmuth/spryker-search-ranking/issues",
        "source": "https://github.com/andrebarthelmeshellmuth/spryker-search-ranking"
    }
}
