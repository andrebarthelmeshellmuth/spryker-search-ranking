<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!-- One ranking metric definition: a named business signal (e.g. pdp_impressions) with the weight
         it contributes to the final score and the normalization formula that maps raw real-world
         values into ]0;1]. The formula is a symfony/expression-language expression over the variables
         x (raw value), min, max, avg, count (per-metric aggregates). shape is a stable curve-family slug
         (e.g. "atan", "sigmoid", "hyperbolic" - see NormalizationCurveFitter/SearchRankingCurveFitCandidate)
         derived automatically at save time by matching the submitted formula against a fresh fit over the
         metric's own digest; null when the formula is a freeform/custom expression that matches no known
         candidate shape (e.g. no digest exists yet, or the admin typed something the fitter doesn't offer).
         Read-only from a consumer's point of view - never set this directly, it is derived, not authored. -->
    <transfer name="SearchRankingMetric" strict="true">
        <property name="idSearchRankingMetric" type="int"/>
        <property name="name" type="string"/>
        <property name="weight" type="float"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="isHigherBetter" type="bool"/>
        <!-- Root fact governing every scoped field this metric owns — formula, isActive, shape, AND
             weight together, one flag for all four, not one per concern. False (default, most metrics):
             this metric is store-wide — all four are authored once and fanned out to every real locale of
             a store automatically when saved. True (rare — evidence via evaluateCurrentMetricFitAcrossLocales()
             first): all four genuinely differ per locale and are authored/stored independently per (store,
             locale). Global identity field, same bucket as isHigherBetter (name/isHigherBetter/isLocaleScoped
             are the only genuinely global fields left on this metric). -->
        <property name="isLocaleScoped" type="bool"/>
        <property name="shape" type="string"/>
        <!-- Optional input to saveMetric(): which SearchRankingConfig::CHANGE_SOURCE_* produced this
             save, recorded on the resulting history row. Null (the default, used by this package's own
             Zed Edit page) means CHANGE_SOURCE_MANUAL — only an automated writer (e.g.
             search-ranking-optimizer's Auto-Tune runner) needs to set this explicitly. Never populated on
             a read; this is a write-only hint, not a persisted field of the metric's own identity. -->
        <property name="changeSource" type="string"/>
    </transfer>

    <transfer name="SearchRankingMetricCollection" strict="true">
        <property name="metrics" type="SearchRankingMetric[]" singular="metric"/>
    </transfer>

    <!-- One metric's weight for one (store, locale) — a metric's identity (name/formula/isActive/
         isHigherBetter/shape, see SearchRankingMetric) is global; only its weight in the combined
         ranking score is store+locale scoped. -->
    <transfer name="SearchRankingMetricWeight" strict="true">
        <property name="idSearchRankingMetricWeight" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="weight" type="float"/>
    </transfer>

    <!-- One product-metric data point: the raw real-world value (e.g. 8250 PDP impressions) and the
         normalized ]0;1] value derived from it by the metric's formula. normalizedValue is null until
         the normalization cron has processed the row. -->
    <transfer name="SearchRankingProductMetric" strict="true">
        <property name="idSearchRankingProductMetric" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="rawValue" type="float"/>
        <property name="normalizedValue" type="float"/>
    </transfer>

    <transfer name="SearchRankingFormulaValidationResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Aggregates of one metric's raw values across all products; exposed to formulas as variables. -->
    <transfer name="SearchRankingMetricStatistics" strict="true">
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="avgValue" type="float"/>
        <property name="count" type="int"/>
    </transfer>

    <transfer name="SearchRankingNormalizationResult" strict="true">
        <property name="processedMetricCount" type="int"/>
        <property name="updatedRowCount" type="int"/>
        <property name="errors" type="string[]" singular="error"/>
    </transfer>

    <!-- A fixed-size distribution digest of one metric's raw_value column, computed as a byproduct of
         the normalize cron (MetricDigestBuilder) so the normalization-authoring GUI never has to touch
         the raw per-product rows: percentiles is the empirical CDF backbone (101 points, at percentiles
         0,1,2,...,100), medianValue doubles as the default fit parameter for the x/(x+k) saturating
         candidate. -->
    <transfer name="SearchRankingMetricDigest" strict="true">
        <property name="idSearchRankingMetricDigest" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="meanValue" type="float"/>
        <property name="medianValue" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="percentiles" type="float[]" singular="percentile"/>
    </transfer>

    <!-- One (store, locale)'s own formula/active-flag/shape for a metric — the store+locale-scoped
         counterpart to SearchRankingMetric's identity fields (name, isHigherBetter, isLocaleScoped stay
         global). For an isLocaleScoped=false metric (the common case) every real locale of a store shares
         the SAME row content, fanned out on save; for isLocaleScoped=true each locale's row is genuinely
         independent. A brand-new store's rows are bootstrapped via Scope Copy's combined "Copy now"/Lock
         action, then independently re-fit and toggled from then on. See
         spy_search_ranking_metric_store_config's own schema column docs for the store-vs-locale
         reasoning. -->
    <transfer name="SearchRankingMetricStoreConfig" strict="true">
        <property name="idSearchRankingMetricStoreConfig" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="shape" type="string"/>
    </transfer>

    <!-- One historical snapshot of a metric's config + digest + computed fit quality, written whenever
         its formula/weight/isActive/isHigherBetter actually changes (isChange=true), and reserved for a
         future periodic check-only snapshot (isChange=false) that recorded no change — see the schema
         column docs on spy_search_ranking_metric_history for why that distinction lets a drift-detection
         query anchor on the last REAL change rather than the last snapshot taken. metricName is
         denormalized so history stays readable even if the live metric is later renamed or deleted.
         min/max/mean/median/sampleCount/percentiles/fitRSquared are null when no digest existed yet at
         snapshot time (e.g. a brand-new metric). -->
    <transfer name="SearchRankingMetricHistory" strict="true">
        <property name="idSearchRankingMetricHistory" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="metricName" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="weight" type="float"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="isHigherBetter" type="bool"/>
        <property name="isLocaleScoped" type="bool"/>
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="meanValue" type="float"/>
        <property name="medianValue" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="percentiles" type="float[]" singular="percentile"/>
        <property name="fitRSquared" type="float"/>
        <property name="isChange" type="bool"/>
        <!-- One of SearchRankingConfig::CHANGE_SOURCE_* - who/what actually produced this row: a human
             editing the metric directly (MANUAL), search-ranking-optimizer's Auto-Tune runner picking a
             new formula on its own (AUTO_TUNE), a human applying an optimizer run's machine-computed
             weight (OPTIMIZER_APPLY), or a human restoring a prior weight checkpoint (CHECKPOINT_RESTORE).
             Always MANUAL for every row this package can write on its own - the other three values only
             ever appear once search-ranking-optimizer is installed and writing through it. -->
        <property name="changeSource" type="string"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- One persistent scope-copy lock: the target scope's metric weights + the 5 tunable settings get
         re-synced from the source scope daily by the scope-copy sync cron, in addition to running once
         immediately when the lock is created. isActive false means an unlocked (soft-deleted) episode -
         rows are never hard-deleted, so the active-locks page can show lock history. A scope's
         eligibility as source/target for a NEW lock is a point-in-time check against isActive=true rows
         only: a target may have at most one active lock, a source may have many, and a scope can never
         be source and target at once - but once unlocked it is fully free again for either role. -->
    <transfer name="SearchRankingScopeCopyLock" strict="true">
        <property name="idSearchRankingScopeCopyLock" type="int"/>
        <property name="sourceStoreName" type="string"/>
        <property name="sourceLocaleName" type="string"/>
        <property name="targetStoreName" type="string"/>
        <property name="targetLocaleName" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="createdAt" type="string"/>
        <property name="deactivatedAt" type="string"/>
    </transfer>

    <transfer name="SearchRankingScopeCopyLockCollection" strict="true">
        <property name="scopeCopyLocks" type="SearchRankingScopeCopyLock[]" singular="scopeCopyLock"/>
    </transfer>

    <!-- Result of a one-off "Copy now" or a lock-creation's immediate copy. isBlockedByExistingData is
         the "block by default, allow via confirm checkbox" overwrite guard - true means the target scope
         already has non-default weights/settings and nothing was written; the caller must resubmit with
         confirmOverwrite to proceed. isSuccess false + errorMessage covers real validation failures
         (source == target, or - for a lock - the source/target role-exclusivity rule). skippedCount is
         MODE_COPY_ONLY_OVERLAP's count of weights/settings the target hasn't independently adopted yet and
         was therefore deliberately left alone - always 0 in MODE_MIRROR. -->
    <transfer name="SearchRankingScopeCopyResult" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="isBlockedByExistingData" type="bool"/>
        <property name="errorMessage" type="string"/>
        <property name="metricWeightCopiedCount" type="int"/>
        <property name="settingCopiedCount" type="int"/>
        <property name="skippedCount" type="int"/>
    </transfer>

    <!-- Result of a one-off store-config sync (formula/isActive/shape — see SearchRankingMetricStoreConfig
         for its own store+locale scoping). Same isBlockedByExistingData/isSuccess+errorMessage shape as
         SearchRankingScopeCopyResult, plus a skippedCount: in MODE_COPY_ONLY_OVERLAP a metric the target
         hasn't already independently adopted is deliberately left alone rather than copied, and
         skippedCount says how many were. -->
    <transfer name="SearchRankingStoreConfigCopyResult" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="isBlockedByExistingData" type="bool"/>
        <property name="errorMessage" type="string"/>
        <property name="copiedCount" type="int"/>
        <property name="skippedCount" type="int"/>
    </transfer>

    <!-- What copyScopeConfiguration() would act on for a given source scope, computed read-only on every
         page load as the Scope Copy page's pickers change — metricWeights/settings mirror the real copy's
         own "explicitly saved only" selection exactly (never a resolved/defaulted value), so the preview
         never shows something the actual copy wouldn't touch. metricWeights is metricName => weight;
         settings is the human-readable setting label => its current value. -->
    <transfer name="SearchRankingScopeCopyPreview" strict="true">
        <property name="metricWeights" type="array" singular="metricWeight" associative="true"/>
        <property name="settings" type="array" singular="setting" associative="true"/>
    </transfer>

    <!-- What copyStoreConfiguration() would act on for a given source store — metricName => an
         associative {formula, isActive} pair, only for metrics with an explicitly saved formula in that
         store. Same "explicitly saved only" semantics as SearchRankingScopeCopyPreview. -->
    <transfer name="SearchRankingStoreConfigPreview" strict="true">
        <property name="metrics" type="array" singular="metric" associative="true"/>
    </transfer>

    <!-- Result of the Scope Copy page's single combined "Copy now" action, aggregating
         ScopeConfigCopierInterface::copyScopeConfiguration() (weight/setting) and
         StoreConfigCopierInterface::copyStoreConfiguration() (formula/isActive/shape) into one outcome —
         same isSuccess/isBlockedByExistingData/errorMessage shape as the two results it wraps.
         storeConfigCopiedCount/storeConfigSkippedCount are always 0 when the source and target store are
         the same (StoreConfigCopierInterface's own guard - see FullScopeCopierInterface). -->
    <transfer name="SearchRankingFullScopeCopyResult" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="isBlockedByExistingData" type="bool"/>
        <property name="errorMessage" type="string"/>
        <property name="metricWeightCopiedCount" type="int"/>
        <property name="settingCopiedCount" type="int"/>
        <property name="skippedCount" type="int"/>
        <property name="storeConfigCopiedCount" type="int"/>
        <property name="storeConfigSkippedCount" type="int"/>
    </transfer>

    <!-- What copyFullScopeConfiguration() would act on for a given source scope — combines
         SearchRankingScopeCopyPreview's metricWeights/settings with SearchRankingStoreConfigPreview's
         metrics (formula/isActive), so the merged Scope Copy widget can render one preview table for its
         one combined "Copy now" action. -->
    <transfer name="SearchRankingFullScopeCopyPreview" strict="true">
        <property name="metricWeights" type="array" singular="metricWeight" associative="true"/>
        <property name="settings" type="array" singular="setting" associative="true"/>
        <property name="storeConfigMetrics" type="array" singular="storeConfigMetric" associative="true"/>
    </transfer>

    <transfer name="SearchRankingSettingHistory" strict="true">
        <property name="idSearchRankingSettingHistory" type="int"/>
        <property name="settingKey" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="settingValue" type="string"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- One (x, y) point of a formula preview curve or the empirical-CDF reference line. xValue is the
         real raw value at that digest percentile; yValue is the normalized result at that point (either
         the typed formula's output, or the percentile fraction itself for the CDF reference line). -->
    <transfer name="SearchRankingFormulaPreviewPoint" strict="true">
        <property name="xValue" type="float"/>
        <property name="yValue" type="float"/>
    </transfer>

    <!-- One candidate normalization curve NormalizationCurveFitter fit against a metric's digest: name
         is the human-readable shape ("x / (x + k)"), shape is the same family as a short stable slug
         ("hyperbolic") independent of isHigherBetter direction or the exact fitted parameter - this is
         what gets persisted onto SearchRankingMetric.shape when a metric is saved with a matching formula.
         formula is that shape with its fitted parameter substituted in (ready to paste into the metric's
         own formula field), rSquared measures fit quality against the empirical CDF (1.0 = perfect),
         isWinner flags the best-fitting candidate. -->
    <transfer name="SearchRankingCurveFitCandidate" strict="true">
        <property name="name" type="string"/>
        <property name="shape" type="string"/>
        <property name="formula" type="string"/>
        <property name="parameterValue" type="float"/>
        <property name="rSquared" type="float"/>
        <property name="isWinner" type="bool"/>
    </transfer>

    <!-- Response shape of the formula-preview AJAX endpoint: points is the typed formula evaluated at
         the metric's digest percentile x-values; cdfPoints is the empirical CDF reference line (the
         theoretical max-discrimination normalizer, drawn on every plot for comparison); candidates is
         NormalizationCurveFitter's ranked suggestions. errorMessage is set instead of points when the
         typed formula fails to evaluate (mirrors SearchRankingFormulaValidationResponse). -->
    <transfer name="SearchRankingFormulaPreview" strict="true">
        <property name="points" type="SearchRankingFormulaPreviewPoint[]" singular="point"/>
        <property name="cdfPoints" type="SearchRankingFormulaPreviewPoint[]" singular="cdfPoint"/>
        <property name="candidates" type="SearchRankingCurveFitCandidate[]" singular="candidate"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Extensions of core ProductPageSearch transfers carrying the normalized signals through the
         publish pipeline: bulk-loaded into the payload (data loader), copied onto the page-search
         transfer (data expander), and finally set on the page map (map expander), from where the
         core document mapper writes any modified PageMap property named after a page.json field
         verbatim into the Elasticsearch document. -->
    <!-- The single key-value storage document the storefront reads at query time: weights of the
         active metrics plus the two blend constants for the function_score script — relevanceWeight
         (how much of the final score comes from normalized text relevance vs. business signals) and
         relevanceSaturationPoint (the raw Elasticsearch _score at which normalized relevance reaches
         0.5; see FunctionScoreBuilder). -->
    <transfer name="SearchRankingConfigurationStorage" strict="true">
        <property name="metricWeights" type="array" singular="metricWeight" associative="true"/>
        <property name="relevanceWeight" type="float"/>
        <property name="relevanceSaturationPoint" type="float"/>
        <!-- Blend weight (alpha) combining normalized text relevance with the semantic (kNN cosine
             similarity) term inside FunctionScoreBuilder's text-relevance component itself — distinct
             from relevanceWeight, which blends text relevance (this whole component) against business
             signals. `alpha = 1.0` (default) means 100% lexical: the semantic term is never computed and
             the script is byte-identical to the pre-hybrid-search formula. Lower values blend in
             `(1 - alpha)` share of `(cosineSimilarity(queryVector, doc['embedding']) + 1) / 2` — only when
             a query vector was actually resolved at query time; per-document, a product with no stored
             embedding still falls back to alpha=1.0 for that one document regardless of this configured
             value, since there is no semantic signal to blend in for it. Not exposed in the Zed GUI yet —
             see FunctionScoreBuilder for the exact formula. -->
        <property name="alpha" type="float"/>
        <!-- Names whichever `metricWeights` key SearchRankingConfig::getRandomMetricName() designates as
             the project's random tie-breaker (default 'random') — lets Yves-reachable code (e.g. a
             random-impact simulation) identify that one metric without hardcoding its name. Project-wide,
             not store/locale scoped, same as the Zed-side config it mirrors. -->
        <property name="randomMetricName" type="string"/>
        <!-- Specificity-aware relevance weighting settings — only read when the Client-layer code flag
             SprykerCommunity\Client\SearchRanking\SearchRankingConfig::isSpecificityWeightingEnabled() is
             enabled; always published regardless, same as every other setting here. specificityBlendWeight
             (alpha) and specificityCurveExponent (p) are tunable by search-ranking-optimizer's own
             blackbox-optimizer search (e.g. CMA-ES); specificitySaturationPoint (k) is Calibration-tunable
             only, same split as
             relevanceSaturationPoint. specificityCurveExponent reshapes the raw-to-normalized-specificity
             curve itself (raw^p / (raw^p + k^p), p=1 reproduces the original raw/(raw+k) shape) —
             distinct from specificityWeightExponent below, which reshapes a later, already-symmetric
             step. -->
        <property name="specificityBlendWeight" type="float"/>
        <property name="specificitySaturationPoint" type="float"/>
        <property name="specificityCurveExponent" type="float"/>
        <property name="specificityWeightExponent" type="float"/>
        <property name="specificityWeightShiftMagnitude" type="float"/>
        <!-- Intent-Aware Alpha, Pass 3: ADDITIVE shifts to relevanceWeight, applied only when the
             corresponding signal is present on the query's SearchRankingQueryContextTransfer
             (detectedBrand / detectedCategory non-null — see NavigationalRelevanceWeightShiftCalculator),
             composed on top of whatever relevanceWeight specificity weighting already produced. Both
             default to 0.0 (unconfigured) so this feature is fully inert unless a project deliberately
             sets a nonzero value — same "not exposed in the Zed GUI yet, still functions" precedent as
             `alpha`. brandMatchRelevanceWeightShift is conventionally POSITIVE when configured (a
             detected brand is evidence of a navigational query — shift toward text relevance), per this
             package's own v2 architecture reasoning; categoryMatchRelevanceWeightShift is a genuinely
             open, sign-agnostic question (a detected category could argue for either direction) and is
             deliberately left unmeasured/untuned here — see NavigationalRelevanceWeightShiftCalculator's
             own docblock. -->
        <property name="brandMatchRelevanceWeightShift" type="float"/>
        <property name="categoryMatchRelevanceWeightShift" type="float"/>
    </transfer>

    <!-- Immutable snapshot of one SpecificityWeightCalculatorInterface::calculateWeightingResult() outcome
         — carries both the relevanceWeight that was actually applied to the real query AND the
         diagnostics behind it (query term count, raw and normalized specificity, the saturation point/
         curve exponent normalization used, shift), so a consumer like the search-debug overlay can show
         the SAME numbers that produced the real score, not just the end result. A failed probe, or a
         query with no terms carrying any real corpus evidence, still produces one of these:
         relevanceWeight equals configuredRelevanceWeight unchanged, and normalizedSpecificity/shift/
         rawSpecificity are 0.0 with queryTermCount 0 — there was simply nothing to measure, not an error. -->
    <transfer name="SearchRankingSpecificityWeightingResult" strict="true">
        <property name="configuredRelevanceWeight" type="float"/>
        <property name="relevanceWeight" type="float"/>
        <property name="normalizedSpecificity" type="float"/>
        <property name="shift" type="float"/>
        <!-- How many of the query's terms carried real corpus evidence (a nonzero doc_freq for at least
             one probed field) and therefore contributed to the specificity calculation (0 when none did,
             or the probe returned no hits or failed). -->
        <property name="queryTermCount" type="int"/>
        <!-- The exponent `shift` was actually shaped with — carried here (not just implied by `shift`'s
             own value) so a consumer like the search-debug overlay can show the calculation that produced
             `shift`, not just the result. -->
        <property name="specificityWeightExponent" type="float"/>
        <!-- The shiftMagnitude `shift` was actually scaled by — same reasoning as
             specificityWeightExponent. -->
        <property name="specificityWeightShiftMagnitude" type="float"/>
        <!-- The pre-normalization blended-IDF value QuerySpecificityCalculatorInterface::calculateRawSpecificity()
             produced from this query's own real ES-sourced term stats — the numerator
             specificitySaturationPoint normalizes into normalizedSpecificity. -->
        <property name="rawSpecificity" type="float"/>
        <!-- The saturationPoint normalizedSpecificity was actually normalized against — the real
             configured value regardless of whether any terms carried evidence, same reasoning as
             specificityWeightExponent. -->
        <property name="specificitySaturationPoint" type="float"/>
        <!-- The curveExponent normalizedSpecificity was actually shaped with — same reasoning as
             specificityWeightExponent. -->
        <property name="specificityCurveExponent" type="float"/>
    </transfer>

    <!-- Per-request query-time intent signal, built once per live catalog search by running the active
         QueryAnalyzerInterface stack (see SearchRankingFactory::getQueryAnalyzers()) and remembered on
         SearchRankingClientInterface::rememberQueryContext() the same way (and for the same reason) the
         specificity weighting result used to be remembered on its own — a stale value from an earlier
         query in the same request must never leak into the next one. Analyzers must not read each other's
         signals off this transfer while it is being built (independence trap) — they only ever WRITE their
         own field(s). isIdentifierMatch/matchedIdentifierValue are written by SkuIdentifierAnalyzer;
         specificityWeightingResult is written by the (today still inline, see FunctionScoreQueryExpanderPlugin)
         specificity-weighting logic. -->
    <transfer name="SearchRankingQueryContext" strict="true">
        <property name="searchString" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <!-- Whether SkuIdentifierAnalyzer recognized `searchString` as an exact product identifier (SKU/
             model number) for this (store, locale) — dictionary hit or shape-regex fallback match. When
             true, FunctionScoreBuilder forces the effective hybrid-search alpha to 1.0 (pure lexical) for
             this one query, overriding whatever alpha a project has configured: semantic similarity
             actively hurts identifier lookups, it doesn't help them. -->
        <!-- No default="false" here: verified this generator does not actually initialize a plain
             property's default value (only the getter's PHPDoc return type gains `|null` either way) —
             every builder of this transfer (SearchRankingFunctionScoreQueryExpanderPlugin::buildQueryContext(),
             every test fixture) sets this explicitly instead. -->
        <property name="isIdentifierMatch" type="bool"/>
        <!-- The real SKU value `searchString` matched, for debuggability/search-debug consumption — null
             when isIdentifierMatch is false, or (shape-regex tier) when a shape matched but no single real
             SKU value did. -->
        <property name="matchedIdentifierValue" type="string"/>
        <!-- Pass 2 of "Intent-Aware Alpha": the real brand name BrandAnalyzer detected as a word-boundary
             match WITHIN `searchString` (not a whole-string match, unlike `matchedIdentifierValue` above —
             a query like "Topstar swivel chair" detects "Topstar" here while `searchString` stays the full
             free-text query). Null when no known brand was found. Deliberately read by NOTHING else yet —
             see BrandAnalyzer's own docblock: detection only, no scoring behavior wired to this field in
             Pass 2. -->
        <property name="detectedBrand" type="string"/>
        <!-- Same contract as `detectedBrand`, for CategoryAnalyzer / real category names. -->
        <property name="detectedCategory" type="string"/>
        <property name="specificityWeightingResult" type="SearchRankingSpecificityWeightingResult"/>
    </transfer>

    <transfer name="ProductPayload">
        <property name="searchRankingScores" type="array" singular="searchRankingScores" associative="true"/>
        <!-- Flat semantic embedding vector (float list, NOT associative) bulk-loaded from
             spy_search_ranking_embedding for this product abstract's (store, locale, modelId), carried
             from EmbeddingPageDataLoader through SearchRankingEmbeddingDataExpanderPlugin. Unset/empty
             when no stored vector exists for this product yet (offline generation job hasn't run, or the
             embeddings service was unavailable when it did). -->
        <property name="embedding" type="array" singular="embedding"/>
    </transfer>

    <transfer name="ProductPageSearch">
        <property name="scores" type="array" singular="scores" associative="true"/>
        <!-- Same flat vector as ProductPayload.embedding, copied across by
             SearchRankingEmbeddingDataExpanderPlugin so it flows into the search document via this
             transfer's generic toArray() -> ProductAbstractSearchDataMapper::mapProductDataToSearchData()
             path, the same way `scores` already does. -->
        <property name="embedding" type="array" singular="embedding"/>
    </transfer>

    <transfer name="PageMap">
        <property name="scores" type="array" singular="scores" associative="true"/>
        <!-- The semantic embedding vector as actually written to the page document's `embedding` field
             (a flat float list, NOT associative — matches the `knn_vector` mapping in page.json); products
             without a stored vector get no `embedding` field at all, mirroring how `scores` is
             omitted-not-empty. See SearchRankingEmbeddingMapExpanderPlugin. -->
        <property name="embedding" type="array" singular="embedding"/>
    </transfer>

    <!-- One capability probe result: a named search-engine construct this package uses today or could use
         in future (e.g. "function_score + script_score (painless)", "rank_feature query"), and whether the
         live engine actually accepts it. Probed live (see EngineCompatibilityChecker) via `_validate/query`
         (or, for the `_rank_eval` endpoint, a real minimal request) rather than trusted from a version
         string — OpenSearch and Elasticsearch report incompatible version numbers under the same API
         surface, so a version-string check is not a reliable oracle here. detail carries the engine's own
         parser message, populated either way (useful context even when isSupported is true). -->
    <transfer name="SearchRankingEngineCapability" strict="true">
        <property name="name" type="string"/>
        <property name="isSupported" type="bool"/>
        <property name="detail" type="string"/>
    </transfer>

    <!-- Result of search-ranking:check-compatibility. distribution/version are the engine's own
         self-reported identification (informational only, e.g. "opensearch"/"1.3.4" vs a bare ES version
         number with no distribution field) — never used to gate a capability, only shown for context
         alongside the real per-construct probes in capabilities. -->
    <transfer name="SearchRankingEngineCompatibility" strict="true">
        <property name="distribution" type="string"/>
        <property name="version" type="string"/>
        <property name="capabilities" type="SearchRankingEngineCapability[]" singular="capability"/>
    </transfer>

    <!-- How much of the back office can actually reach this package's Zed pages, for
         `search-ranking:check-installation` to report on. Zed access is deny-by-default outside a matching
         ACL rule, and a nav entry the current user has no rule for is filtered out of the sidebar entirely
         (see Spryker's own AclNavigationItemFilterPlugin) rather than 403ing — so "the adopter never
         adjusted ACL" looks exactly like "the package was never installed".

         The split that matters is unrestrictedRoleCount vs restrictedRoleCount. A default Spryker install
         gives root_role a total wildcard and puts every installer user in root_group, so these pages are
         reachable out of the box and nothing needs doing — that is the unrestricted count. Roles carrying
         explicit per-module rules instead are the restricted count, and they reach nothing here until
         somebody adds a rule. restrictedRoleWithAccessCount separates "the adopter pointed a restricted
         role at this feature" from "no restricted role can see it", which is the only state worth
         mentioning — and even then only as something to confirm, never as a failure: restricting these
         pages to root-style admins is a perfectly ordinary choice.

         Counts rather than names deliberately: this is a yes/no/how-many signal about the shape of an
         installation, and printing an adopter's internal role names into console output buys nothing. -->
    <transfer name="SearchRankingBackOfficeAccessDiagnosis" strict="true">
        <property name="moduleNames" type="string[]" singular="moduleName"/>
        <property name="unrestrictedRoleCount" type="int"/>
        <property name="restrictedRoleCount" type="int"/>
        <property name="restrictedRoleWithAccessCount" type="int"/>
    </transfer>

    <!-- Raw facts behind `search-ranking:check-installation`'s entity-lookup sync check (Pass 2's index
         has two independent, adopter's-choice sync mechanisms - see
         SearchRankingCheckInstallationConsole::checkEntityLookupSyncConfiguration() for the 0/1/2
         pass/notice/error decision built from these). eventHookRegistrationUnknown is true when the
         event-hook plugin registration could not be introspected at all (module absent, or the resolved
         provider couldn't be reflected into) - deliberately distinct from a confirmed-false eventHookRegistered,
         same "cannot tell" vs "no" distinction the console already applies elsewhere. -->
    <transfer name="SearchRankingEntityLookupSyncDiagnosis" strict="true">
        <property name="cronConfigured" type="bool"/>
        <property name="eventHookRegistered" type="bool"/>
        <property name="eventHookRegistrationUnknown" type="bool"/>
    </transfer>

</transfers>
