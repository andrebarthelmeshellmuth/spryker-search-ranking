<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!-- One ranking metric definition: a named business signal (e.g. pdp_impressions) with the weight
         it contributes to the final score and the normalization formula that maps raw real-world
         values into ]0;1]. The formula is a symfony/expression-language expression over the variables
         x (raw value), min, max, avg, count (per-metric aggregates). shape is a stable curve-family slug
         (e.g. "atan", "sigmoid", "hyperbolic" - see NormalizationCurveFitter/SearchRankingCurveFitCandidate)
         derived automatically at save time by matching the submitted formula against a fresh fit over the
         metric's own digest; null when the formula is a freeform/custom expression that matches no known
         candidate shape (e.g. no digest exists yet, or the admin typed something the fitter doesn't offer).
         Read-only from a consumer's point of view - never set this directly, it is derived, not authored. -->
    <transfer name="SearchRankingMetric" strict="true">
        <property name="idSearchRankingMetric" type="int"/>
        <property name="name" type="string"/>
        <property name="weight" type="float"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="isHigherBetter" type="bool"/>
        <property name="shape" type="string"/>
        <!-- Optional input to saveMetric(): which SearchRankingConfig::CHANGE_SOURCE_* produced this
             save, recorded on the resulting history row. Null (the default, used by this package's own
             Zed Edit page) means CHANGE_SOURCE_MANUAL — only an automated writer (e.g.
             search-ranking-optimizer's Auto-Tune runner) needs to set this explicitly. Never populated on
             a read; this is a write-only hint, not a persisted field of the metric's own identity. -->
        <property name="changeSource" type="string"/>
    </transfer>

    <transfer name="SearchRankingMetricCollection" strict="true">
        <property name="metrics" type="SearchRankingMetric[]" singular="metric"/>
    </transfer>

    <!-- One metric's weight for one (store, locale) — a metric's identity (name/formula/isActive/
         isHigherBetter/shape, see SearchRankingMetric) is global; only its weight in the combined
         ranking score is store+locale scoped. -->
    <transfer name="SearchRankingMetricWeight" strict="true">
        <property name="idSearchRankingMetricWeight" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="weight" type="float"/>
    </transfer>

    <!-- One product-metric data point: the raw real-world value (e.g. 8250 PDP impressions) and the
         normalized ]0;1] value derived from it by the metric's formula. normalizedValue is null until
         the normalization cron has processed the row. -->
    <transfer name="SearchRankingProductMetric" strict="true">
        <property name="idSearchRankingProductMetric" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="rawValue" type="float"/>
        <property name="normalizedValue" type="float"/>
    </transfer>

    <transfer name="SearchRankingFormulaValidationResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Aggregates of one metric's raw values across all products; exposed to formulas as variables. -->
    <transfer name="SearchRankingMetricStatistics" strict="true">
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="avgValue" type="float"/>
        <property name="count" type="int"/>
    </transfer>

    <transfer name="SearchRankingNormalizationResult" strict="true">
        <property name="processedMetricCount" type="int"/>
        <property name="updatedRowCount" type="int"/>
        <property name="errors" type="string[]" singular="error"/>
    </transfer>

    <!-- A fixed-size distribution digest of one metric's raw_value column, computed as a byproduct of
         the normalize cron (MetricDigestBuilder) so the normalization-authoring GUI never has to touch
         the raw per-product rows: percentiles is the empirical CDF backbone (101 points, at percentiles
         0,1,2,...,100), medianValue doubles as the default fit parameter for the x/(x+k) saturating
         candidate. -->
    <transfer name="SearchRankingMetricDigest" strict="true">
        <property name="idSearchRankingMetricDigest" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="meanValue" type="float"/>
        <property name="medianValue" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="percentiles" type="float[]" singular="percentile"/>
    </transfer>

    <!-- One store's own formula/active-flag/shape for a metric — the store-scoped counterpart to
         SearchRankingMetric's identity fields (name, isHigherBetter stay global). Bootstrapped from the
         metric's then-global formula/isActive/shape at Phase 1 of the store-scoping migration; each
         store's own row is independently re-fit and toggled from then on. See
         spy_search_ranking_metric_store_config's own schema column docs for the store-vs-locale
         reasoning. -->
    <transfer name="SearchRankingMetricStoreConfig" strict="true">
        <property name="idSearchRankingMetricStoreConfig" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="shape" type="string"/>
    </transfer>

    <!-- One historical snapshot of a metric's config + digest + computed fit quality, written whenever
         its formula/weight/isActive/isHigherBetter actually changes (isChange=true), and reserved for a
         future periodic check-only snapshot (isChange=false) that recorded no change — see the schema
         column docs on spy_search_ranking_metric_history for why that distinction lets a drift-detection
         query anchor on the last REAL change rather than the last snapshot taken. metricName is
         denormalized so history stays readable even if the live metric is later renamed or deleted.
         min/max/mean/median/sampleCount/percentiles/fitRSquared are null when no digest existed yet at
         snapshot time (e.g. a brand-new metric). -->
    <transfer name="SearchRankingMetricHistory" strict="true">
        <property name="idSearchRankingMetricHistory" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="metricName" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="weight" type="float"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="isHigherBetter" type="bool"/>
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="meanValue" type="float"/>
        <property name="medianValue" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="percentiles" type="float[]" singular="percentile"/>
        <property name="fitRSquared" type="float"/>
        <property name="isChange" type="bool"/>
        <!-- One of SearchRankingConfig::CHANGE_SOURCE_* - who/what actually produced this row: a human
             editing the metric directly (MANUAL), search-ranking-optimizer's Auto-Tune runner picking a
             new formula on its own (AUTO_TUNE), a human applying an optimizer run's machine-computed
             weight (OPTIMIZER_APPLY), or a human restoring a prior weight checkpoint (CHECKPOINT_RESTORE).
             Always MANUAL for every row this package can write on its own - the other three values only
             ever appear once search-ranking-optimizer is installed and writing through it. -->
        <property name="changeSource" type="string"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- One persistent scope-copy lock: the target scope's metric weights + the 5 tunable settings get
         re-synced from the source scope daily by the scope-copy sync cron, in addition to running once
         immediately when the lock is created. isActive false means an unlocked (soft-deleted) episode -
         rows are never hard-deleted, so the active-locks page can show lock history. A scope's
         eligibility as source/target for a NEW lock is a point-in-time check against isActive=true rows
         only: a target may have at most one active lock, a source may have many, and a scope can never
         be source and target at once - but once unlocked it is fully free again for either role. -->
    <transfer name="SearchRankingScopeCopyLock" strict="true">
        <property name="idSearchRankingScopeCopyLock" type="int"/>
        <property name="sourceStoreName" type="string"/>
        <property name="sourceLocaleName" type="string"/>
        <property name="targetStoreName" type="string"/>
        <property name="targetLocaleName" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="createdAt" type="string"/>
        <property name="deactivatedAt" type="string"/>
    </transfer>

    <transfer name="SearchRankingScopeCopyLockCollection" strict="true">
        <property name="scopeCopyLocks" type="SearchRankingScopeCopyLock[]" singular="scopeCopyLock"/>
    </transfer>

    <!-- Result of a one-off "Copy now" or a lock-creation's immediate copy. isBlockedByExistingData is
         the "block by default, allow via confirm checkbox" overwrite guard - true means the target scope
         already has non-default weights/settings and nothing was written; the caller must resubmit with
         confirmOverwrite to proceed. isSuccess false + errorMessage covers real validation failures
         (source == target, or - for a lock - the source/target role-exclusivity rule). -->
    <transfer name="SearchRankingScopeCopyResult" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="isBlockedByExistingData" type="bool"/>
        <property name="errorMessage" type="string"/>
        <property name="metricWeightCopiedCount" type="int"/>
        <property name="settingCopiedCount" type="int"/>
    </transfer>

    <!-- Result of a one-off store-config sync (formula/isActive/shape, store-only — see
         SearchRankingMetricStoreConfig). Same isBlockedByExistingData/isSuccess+errorMessage shape as
         SearchRankingScopeCopyResult, but store-only (no locale in the block/error semantics) and with a
         skippedCount: in MODE_COPY_ONLY_OVERLAP a metric the target hasn't already independently adopted
         is deliberately left alone rather than copied, and skippedCount says how many were. -->
    <transfer name="SearchRankingStoreConfigCopyResult" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="isBlockedByExistingData" type="bool"/>
        <property name="errorMessage" type="string"/>
        <property name="copiedCount" type="int"/>
        <property name="skippedCount" type="int"/>
    </transfer>

    <transfer name="SearchRankingSettingHistory" strict="true">
        <property name="idSearchRankingSettingHistory" type="int"/>
        <property name="settingKey" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="settingValue" type="string"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- One (x, y) point of a formula preview curve or the empirical-CDF reference line. xValue is the
         real raw value at that digest percentile; yValue is the normalized result at that point (either
         the typed formula's output, or the percentile fraction itself for the CDF reference line). -->
    <transfer name="SearchRankingFormulaPreviewPoint" strict="true">
        <property name="xValue" type="float"/>
        <property name="yValue" type="float"/>
    </transfer>

    <!-- One candidate normalization curve NormalizationCurveFitter fit against a metric's digest: name
         is the human-readable shape ("x / (x + k)"), shape is the same family as a short stable slug
         ("hyperbolic") independent of isHigherBetter direction or the exact fitted parameter - this is
         what gets persisted onto SearchRankingMetric.shape when a metric is saved with a matching formula.
         formula is that shape with its fitted parameter substituted in (ready to paste into the metric's
         own formula field), rSquared measures fit quality against the empirical CDF (1.0 = perfect),
         isWinner flags the best-fitting candidate. -->
    <transfer name="SearchRankingCurveFitCandidate" strict="true">
        <property name="name" type="string"/>
        <property name="shape" type="string"/>
        <property name="formula" type="string"/>
        <property name="parameterValue" type="float"/>
        <property name="rSquared" type="float"/>
        <property name="isWinner" type="bool"/>
    </transfer>

    <!-- Response shape of the formula-preview AJAX endpoint: points is the typed formula evaluated at
         the metric's digest percentile x-values; cdfPoints is the empirical CDF reference line (the
         theoretical max-discrimination normalizer, drawn on every plot for comparison); candidates is
         NormalizationCurveFitter's ranked suggestions. errorMessage is set instead of points when the
         typed formula fails to evaluate (mirrors SearchRankingFormulaValidationResponse). -->
    <transfer name="SearchRankingFormulaPreview" strict="true">
        <property name="points" type="SearchRankingFormulaPreviewPoint[]" singular="point"/>
        <property name="cdfPoints" type="SearchRankingFormulaPreviewPoint[]" singular="cdfPoint"/>
        <property name="candidates" type="SearchRankingCurveFitCandidate[]" singular="candidate"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Extensions of core ProductPageSearch transfers carrying the normalized signals through the
         publish pipeline: bulk-loaded into the payload (data loader), copied onto the page-search
         transfer (data expander), and finally set on the page map (map expander), from where the
         core document mapper writes any modified PageMap property named after a page.json field
         verbatim into the Elasticsearch document. -->
    <!-- The single key-value storage document the storefront reads at query time: weights of the
         active metrics plus the two blend constants for the function_score script — relevanceWeight
         (how much of the final score comes from normalized text relevance vs. business signals) and
         relevanceSaturationPoint (the raw Elasticsearch _score at which normalized relevance reaches
         0.5; see FunctionScoreBuilder). -->
    <transfer name="SearchRankingConfigurationStorage" strict="true">
        <property name="metricWeights" type="array" singular="metricWeight" associative="true"/>
        <property name="relevanceWeight" type="float"/>
        <property name="relevanceSaturationPoint" type="float"/>
        <!-- Specificity-aware relevance weighting settings — only read when the Client-layer code flag
             SprykerCommunity\Client\SearchRanking\SearchRankingConfig::isSpecificityWeightingEnabled() is
             enabled; always published regardless, same as every other setting here. specificityBlendWeight
             (alpha) is CMA-ES-tunable (search-ranking-optimizer); specificitySaturationPoint (k) is
             Calibration-tunable only, same split as relevanceSaturationPoint. -->
        <property name="specificityBlendWeight" type="float"/>
        <property name="specificitySaturationPoint" type="float"/>
        <property name="specificityWeightExponent" type="float"/>
        <property name="specificityWeightShiftMagnitude" type="float"/>
    </transfer>

    <transfer name="ProductPayload">
        <property name="searchRankingScores" type="array" singular="searchRankingScores" associative="true"/>
    </transfer>

    <transfer name="ProductPageSearch">
        <property name="scores" type="array" singular="scores" associative="true"/>
    </transfer>

    <transfer name="PageMap">
        <property name="scores" type="array" singular="scores" associative="true"/>
    </transfer>

    <!-- One capability probe result: a named search-engine construct this package uses today or could use
         in future (e.g. "function_score + script_score (painless)", "rank_feature query"), and whether the
         live engine actually accepts it. Probed live (see EngineCompatibilityChecker) via `_validate/query`
         (or, for the `_rank_eval` endpoint, a real minimal request) rather than trusted from a version
         string — OpenSearch and Elasticsearch report incompatible version numbers under the same API
         surface, so a version-string check is not a reliable oracle here. detail carries the engine's own
         parser message, populated either way (useful context even when isSupported is true). -->
    <transfer name="SearchRankingEngineCapability" strict="true">
        <property name="name" type="string"/>
        <property name="isSupported" type="bool"/>
        <property name="detail" type="string"/>
    </transfer>

    <!-- Result of search-ranking:check-compatibility. distribution/version are the engine's own
         self-reported identification (informational only, e.g. "opensearch"/"1.3.4" vs a bare ES version
         number with no distribution field) — never used to gate a capability, only shown for context
         alongside the real per-construct probes in capabilities. -->
    <transfer name="SearchRankingEngineCompatibility" strict="true">
        <property name="distribution" type="string"/>
        <property name="version" type="string"/>
        <property name="capabilities" type="SearchRankingEngineCapability[]" singular="capability"/>
    </transfer>


</transfers>
