<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!-- One ranking metric definition: a named business signal (e.g. pdp_impressions) with the weight
         it contributes to the final score and the normalization formula that maps raw real-world
         values into ]0;1]. The formula is a symfony/expression-language expression over the variables
         x (raw value), min, max, avg, count (per-metric aggregates). -->
    <transfer name="SearchRankingMetric" strict="true">
        <property name="idSearchRankingMetric" type="int"/>
        <property name="name" type="string"/>
        <property name="weight" type="float"/>
        <property name="formula" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="isHigherBetter" type="bool"/>
    </transfer>

    <transfer name="SearchRankingMetricCollection" strict="true">
        <property name="metrics" type="SearchRankingMetric[]" singular="metric"/>
    </transfer>

    <!-- One product-metric data point: the raw real-world value (e.g. 8250 PDP impressions) and the
         normalized ]0;1] value derived from it by the metric's formula. normalizedValue is null until
         the normalization cron has processed the row. -->
    <transfer name="SearchRankingProductMetric" strict="true">
        <property name="idSearchRankingProductMetric" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="rawValue" type="float"/>
        <property name="normalizedValue" type="float"/>
    </transfer>

    <transfer name="SearchRankingFormulaValidationResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Aggregates of one metric's raw values across all products; exposed to formulas as variables. -->
    <transfer name="SearchRankingMetricStatistics" strict="true">
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="avgValue" type="float"/>
        <property name="count" type="int"/>
    </transfer>

    <transfer name="SearchRankingNormalizationResult" strict="true">
        <property name="processedMetricCount" type="int"/>
        <property name="updatedRowCount" type="int"/>
        <property name="errors" type="string[]" singular="error"/>
    </transfer>

    <!-- A fixed-size distribution digest of one metric's raw_value column, computed as a byproduct of
         the normalize cron (MetricDigestBuilder) so the normalization-authoring GUI (phase 4.5) never
         has to touch the raw per-product rows: percentiles is the empirical CDF backbone (101 points,
         at percentiles 0,1,2,...,100), medianValue doubles as the default fit parameter for the
         x/(x+k) saturating candidate. -->
    <transfer name="SearchRankingMetricDigest" strict="true">
        <property name="idSearchRankingMetricDigest" type="int"/>
        <property name="fkSearchRankingMetric" type="int"/>
        <property name="minValue" type="float"/>
        <property name="maxValue" type="float"/>
        <property name="meanValue" type="float"/>
        <property name="medianValue" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="percentiles" type="float[]" singular="percentile"/>
    </transfer>

    <!-- One (x, y) point of a formula preview curve or the empirical-CDF reference line. xValue is the
         real raw value at that digest percentile; yValue is the normalized result at that point (either
         the typed formula's output, or the percentile fraction itself for the CDF reference line). -->
    <transfer name="SearchRankingFormulaPreviewPoint" strict="true">
        <property name="xValue" type="float"/>
        <property name="yValue" type="float"/>
    </transfer>

    <!-- One candidate normalization curve NormalizationCurveFitter fit against a metric's digest: name
         is the human-readable shape ("x / (x + k)"), formula is that shape with its fitted parameter
         substituted in (ready to paste into the metric's own formula field), rSquared measures fit
         quality against the empirical CDF (1.0 = perfect), isWinner flags the best-fitting candidate. -->
    <transfer name="SearchRankingCurveFitCandidate" strict="true">
        <property name="name" type="string"/>
        <property name="formula" type="string"/>
        <property name="parameterValue" type="float"/>
        <property name="rSquared" type="float"/>
        <property name="isWinner" type="bool"/>
    </transfer>

    <!-- Response shape of the formula-preview AJAX endpoint: points is the typed formula evaluated at
         the metric's digest percentile x-values; cdfPoints is the empirical CDF reference line (the
         theoretical max-discrimination normalizer, drawn on every plot for comparison); candidates is
         NormalizationCurveFitter's ranked suggestions. errorMessage is set instead of points when the
         typed formula fails to evaluate (mirrors SearchRankingFormulaValidationResponse). -->
    <transfer name="SearchRankingFormulaPreview" strict="true">
        <property name="points" type="SearchRankingFormulaPreviewPoint[]" singular="point"/>
        <property name="cdfPoints" type="SearchRankingFormulaPreviewPoint[]" singular="cdfPoint"/>
        <property name="candidates" type="SearchRankingCurveFitCandidate[]" singular="candidate"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Extensions of core ProductPageSearch transfers carrying the normalized signals through the
         publish pipeline: bulk-loaded into the payload (data loader), copied onto the page-search
         transfer (data expander), and finally set on the page map (map expander), from where the
         core document mapper writes any modified PageMap property named after a page.json field
         verbatim into the Elasticsearch document. -->
    <!-- The single key-value storage document the storefront reads at query time: weights of the
         active metrics plus the two blend constants for the function_score script — relevanceWeight
         (how much of the final score comes from normalized text relevance vs. business signals) and
         relevanceSaturationPoint (the raw Elasticsearch _score at which normalized relevance reaches
         0.5; see FunctionScoreBuilder). -->
    <transfer name="SearchRankingConfigurationStorage" strict="true">
        <property name="metricWeights" type="array" singular="metricWeight" associative="true"/>
        <property name="relevanceWeight" type="float"/>
        <property name="relevanceSaturationPoint" type="float"/>
    </transfer>

    <transfer name="ProductPayload">
        <property name="searchRankingScores" type="array" singular="searchRankingScores"/>
    </transfer>

    <transfer name="ProductPageSearch">
        <property name="scores" type="array" singular="scores"/>
    </transfer>

    <transfer name="PageMap">
        <property name="scores" type="array" singular="scores"/>
    </transfer>

    <!-- One calibration run: an admin-uploaded list of "relevant" search terms, sampled against the
         live raw text-relevance score (BEFORE any function_score wrapper) to suggest a
         relevanceSaturationPoint (k) value — the pooled mean of the top relevantProductCount (X) hits'
         scores across every search term. status is one of the SearchRankingConfig::CALIBRATION_STATUS_*
         constants; the score*/sampleCount/computedK/calculatedAt fields are null until status=calculated,
         errorMessage is set only on status=failed. -->
    <transfer name="SearchRankingCalibration" strict="true">
        <property name="idSearchRankingCalibration" type="int"/>
        <property name="relevantProductCount" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="status" type="string"/>
        <property name="computedK" type="float"/>
        <property name="scoreMin" type="float"/>
        <property name="scoreMax" type="float"/>
        <property name="scoreMean" type="float"/>
        <property name="scoreMedian" type="float"/>
        <property name="scoreP25" type="float"/>
        <property name="scoreP75" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="calculatedAt" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="searchTerms" type="SearchRankingCalibrationSearchTerm[]" singular="searchTerm"/>
    </transfer>

    <!-- One uploaded search term of a calibration run. scores is populated by the calibration cron: the
         raw text-relevance scores of the top-ranked products found for this term, up to the run's
         relevantProductCount — fewer when the term matched fewer products. Null until calculated. -->
    <transfer name="SearchRankingCalibrationSearchTerm" strict="true">
        <property name="idSearchRankingCalibrationSearchTerm" type="int"/>
        <property name="fkSearchRankingCalibration" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="productsFound" type="int"/>
        <property name="scores" type="float[]" singular="score"/>
    </transfer>

</transfers>
