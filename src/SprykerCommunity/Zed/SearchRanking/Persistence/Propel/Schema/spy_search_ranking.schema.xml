<?xml version="1.0"?>
<database xmlns="spryker:schema-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="zed" namespace="Orm\Zed\SearchRanking\Persistence" package="src.Orm.Zed.SearchRanking.Persistence" xsi:schemaLocation="spryker:schema-01 https://static.spryker.com/schema-01.xsd">

    <table name="spy_search_ranking_metric" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_metric" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="name" type="VARCHAR" size="128" required="true" description="Machine name of the business signal, e.g. pdp_impressions."/>
        <column name="weight" type="FLOAT" required="true" defaultValue="0" description="Weight of this metric in the combined ranking score."/>
        <column name="formula" type="VARCHAR" size="512" required="true" description="Normalization expression mapping raw values into ]0;1]; variables: x, min, max, avg, count."/>
        <column name="is_active" type="BOOLEAN" required="true" defaultValue="true" description="Only active metrics are normalized and exported to the search index."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_metric_pk_seq"/>

        <unique name="spy_search_ranking_metric-name">
            <unique-column name="name"/>
        </unique>
    </table>

    <table name="spy_search_ranking_setting" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_setting" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="setting_key" type="VARCHAR" size="64" required="true" description="Machine name of the setting, e.g. relevance_weight."/>
        <column name="setting_value" type="VARCHAR" size="255" required="true"/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_setting_pk_seq"/>

        <unique name="spy_search_ranking_setting-setting_key">
            <unique-column name="setting_key"/>
        </unique>
    </table>

    <table name="spy_search_ranking_product_metric" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_product_metric" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="fk_search_ranking_metric" type="INTEGER" required="true"/>
        <column name="fk_product_abstract" type="INTEGER" required="true"/>
        <column name="raw_value" type="DOUBLE" required="true" defaultValue="0" description="Real-world signal value, e.g. number of PDP impressions."/>
        <column name="normalized_value" type="DOUBLE" required="false" description="Value in ]0;1] derived from raw_value by the metric formula; null until the normalization cron ran."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_product_metric_pk_seq"/>

        <foreign-key name="spy_search_ranking_product_metric-fk_metric" foreignTable="spy_search_ranking_metric" phpName="SearchRankingMetric" refPhpName="SearchRankingProductMetric" onDelete="CASCADE">
            <reference local="fk_search_ranking_metric" foreign="id_search_ranking_metric"/>
        </foreign-key>

        <foreign-key name="spy_search_ranking_product_metric-fk_product_abstract" foreignTable="spy_product_abstract" phpName="ProductAbstract" refPhpName="SearchRankingProductMetric" onDelete="CASCADE">
            <reference local="fk_product_abstract" foreign="id_product_abstract"/>
        </foreign-key>

        <index name="index-spy_srpm-fk_search_ranking_metric">
            <index-column name="fk_search_ranking_metric"/>
        </index>

        <index name="index-spy_srpm-fk_product_abstract">
            <index-column name="fk_product_abstract"/>
        </index>

        <unique name="spy_srpm-unique-metric-product">
            <unique-column name="fk_search_ranking_metric"/>
            <unique-column name="fk_product_abstract"/>
        </unique>
    </table>

    <table name="spy_search_ranking_calibration" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_calibration" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="relevant_product_count" type="INTEGER" required="true" description="X: number of top-ranked products per search term assumed relevant, e.g. 6."/>
        <column name="store_name" type="VARCHAR" size="64" required="true" description="Store the calibration query runs against, e.g. DE — picked by the admin at upload time, since Zed has no implicit current store."/>
        <column name="locale_name" type="VARCHAR" size="16" required="true" description="Locale the calibration query runs against, e.g. de_DE — picked by the admin at upload time."/>
        <column name="status" type="VARCHAR" size="32" required="true" defaultValue="uploaded" description="uploaded, skipped, calculating, calculated or failed."/>
        <column name="computed_k" type="DOUBLE" required="false" description="Pooled mean text-relevance score across all sampled products; the calculated relevanceSaturationPoint suggestion."/>
        <column name="score_min" type="DOUBLE" required="false"/>
        <column name="score_max" type="DOUBLE" required="false"/>
        <column name="score_mean" type="DOUBLE" required="false"/>
        <column name="score_median" type="DOUBLE" required="false"/>
        <column name="score_p25" type="DOUBLE" required="false"/>
        <column name="score_p75" type="DOUBLE" required="false"/>
        <column name="sample_count" type="INTEGER" required="false" description="Total number of pooled product scores the stats were computed from."/>
        <column name="calculated_at" type="TIMESTAMP" required="false"/>
        <column name="error_message" type="VARCHAR" size="1024" required="false"/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_calibration_pk_seq"/>

        <index name="index-spy_src-status">
            <index-column name="status"/>
        </index>
    </table>

    <table name="spy_search_ranking_calibration_search_term" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_calibration_search_term" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="fk_search_ranking_calibration" type="INTEGER" required="true"/>
        <column name="search_term" type="VARCHAR" size="255" required="true"/>
        <column name="products_found" type="INTEGER" required="false" description="Null until calculated; may be less than the run's relevant_product_count."/>
        <column name="scores" type="LONGVARCHAR" required="false" description="Comma-separated raw text-relevance scores, one per found product, null until calculated."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_calibration_search_term_pk_seq"/>

        <foreign-key name="spy_src_search_term-fk_calibration" foreignTable="spy_search_ranking_calibration" phpName="SearchRankingCalibration" refPhpName="SearchRankingCalibrationSearchTerm" onDelete="CASCADE">
            <reference local="fk_search_ranking_calibration" foreign="id_search_ranking_calibration"/>
        </foreign-key>

        <index name="index-spy_src_search_term-fk_calibration">
            <index-column name="fk_search_ranking_calibration"/>
        </index>
    </table>

</database>
