<?xml version="1.0" encoding="UTF-8"?>
<config>
    <search-ranking-gui>
        <label>Search Ranking</label>
        <title>Search Ranking</title>
        <icon>fa-sliders</icon>
        <bundle>search-ranking-gui</bundle>
        <controller>index</controller>
        <action>index</action>
        <pages>
            <search-ranking-metrics>
                <label>Metrics</label>
                <title>Metrics</title>
                <bundle>search-ranking-gui</bundle>
                <controller>index</controller>
                <action>index</action>
            </search-ranking-metrics>
            <search-ranking-product-metrics>
                <label>Product Values</label>
                <title>Product Values</title>
                <bundle>search-ranking-gui</bundle>
                <controller>product-metric</controller>
                <action>index</action>
            </search-ranking-product-metrics>
            <search-ranking-settings>
                <label>Settings</label>
                <title>Settings</title>
                <bundle>search-ranking-gui</bundle>
                <controller>settings</controller>
                <action>index</action>
            </search-ranking-settings>
            <search-ranking-calibration>
                <label>Calibration</label>
                <title>Calibration</title>
                <bundle>search-ranking-gui</bundle>
                <controller>calibration</controller>
                <action>index</action>
            </search-ranking-calibration>
            <search-ranking-metric-history>
                <label>History</label>
                <title>Metric History</title>
                <bundle>search-ranking-gui</bundle>
                <controller>metric-history</controller>
                <action>index</action>
            </search-ranking-metric-history>
            <search-ranking-calibration-apply>
                <label>Apply Calibration</label>
                <title>Apply Calibration</title>
                <bundle>search-ranking-gui</bundle>
                <controller>calibration-apply</controller>
                <action>index</action>
                <visible>0</visible>
            </search-ranking-calibration-apply>
            <search-ranking-create-metric>
                <label>Create Metric</label>
                <title>Create Metric</title>
                <bundle>search-ranking-gui</bundle>
                <controller>create</controller>
                <action>index</action>
                <visible>0</visible>
            </search-ranking-create-metric>
            <search-ranking-edit-metric>
                <label>Edit Metric</label>
                <title>Edit Metric</title>
                <bundle>search-ranking-gui</bundle>
                <controller>edit</controller>
                <action>index</action>
                <visible>0</visible>
            </search-ranking-edit-metric>
        </pages>
    </search-ranking-gui>
</config>
