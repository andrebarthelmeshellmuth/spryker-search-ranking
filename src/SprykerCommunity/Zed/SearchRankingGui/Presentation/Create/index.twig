{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Create Ranking Metric' %}
{% block section_title %}{{ widget_title | trans }}{% endblock %}

{% block action %}
    {{ backActionButton('/search-ranking-gui', 'Back to Metrics' | trans) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Create Ranking Metric' } %}
        {% block widget_content %}
            {{ form_start(metricForm, {'action': formAction}) }}
            {{ form_widget(metricForm) }}
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">{{ 'Save' | trans }}</button>
            </div>
            {{ form_end(metricForm) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
