{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Search Ranking Metrics' %}
{% block section_title %}{{ widget_title | trans }}{% endblock %}

{% block action %}
    {{ createActionButton('/search-ranking-gui/create?storeName=' ~ selectedStoreName ~ '&localeName=' ~ selectedLocaleName, 'Create Metric' | trans) }}
    {{ viewActionButton('/search-ranking-gui/product-metric', 'View Product Values' | trans) }}
    {# A real POST form (not a plain link, like the two buttons above) — this action WRITES (persists
       normalized weights into every active metric's weight column), so it needs the same
       CSRF-protected-POST treatment as the per-row Delete action, not a GET navigation. Materializes on
       demand the SAME normalization already forced on every publish (see RankingConfigurationStorageWriter
       in the search-ranking package) into the weight column itself, so what's shown here matches what's
       actually used — a transparency action, not a correctness requirement. #}
    {{ form_start(normalizeWeightsForm, {'action': '/search-ranking-gui/normalize-weights?storeName=' ~ selectedStoreName ~ '&localeName=' ~ selectedLocaleName, 'attr': {'class': 'd-inline-block', 'style': 'margin-left: 5px;'}}) }}
        <button type="submit" class="btn btn-default">{{ 'Normalize active weights' | trans }}</button>
    {{ form_end(normalizeWeightsForm) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'List of Ranking Metrics' } %}
        {% block widget_content %}
            <form method="get" class="form-inline" style="margin-bottom: 15px;">
                <label for="storeName">{{ 'Store' | trans }}</label>
                <select name="storeName" id="storeName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == selectedStoreName %}selected="selected"{% endif %}>
                            {{ store }}
                        </option>
                    {% endfor %}
                </select>
                <label for="localeName" style="margin-left: 10px;">{{ 'Locale' | trans }}</label>
                <select name="localeName" id="localeName" class="form-control" onchange="this.form.submit()">
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == selectedLocaleName %}selected="selected"{% endif %}>
                            {{ locale }}
                        </option>
                    {% endfor %}
                </select>
            </form>
            <p class="text-muted" style="margin-bottom: 15px;">
                {{ 'Scope column shows how each metric is authored. "Store" (default): formula, active status and weight apply per store, across every locale. "Store + locale": this metric genuinely differs per locale — formula, active status and weight all apply to this exact store+locale, switch Locale above to see/edit a different one.' | trans }}
            </p>
            {{ metricTable | raw }}
        {% endblock %}
    {% endembed %}
{% endblock %}
