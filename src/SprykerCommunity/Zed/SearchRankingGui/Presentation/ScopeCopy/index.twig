{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Scope Copy' %}
{% block section_title %}{{ widget_title | trans }}{% endblock %}

{% block action %}
    {{ backActionButton('/search-ranking-gui', 'Back to Metrics' | trans) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Copy configuration between store/locale scopes' } %}
        {% block widget_content %}
            <p>
                Copies every metric weight, setting, and formula/active flag explicitly saved for the
                source scope onto the target scope — a starting point for a newly expanded market, not a
                substitute for its own real data. Product-level metrics are never copied; a freshly
                bootstrapped market still shows its own honest gaps.
            </p>
            <p>
                For an <code>isLocaleScoped=false</code> metric (most metrics) formula/active fan out to
                every real locale of the target store regardless of which target locale is picked below,
                same as weight already does; for an <code>isLocaleScoped=true</code> one, all four stay
                scoped to exactly the target store+locale picked here. Copying between two locales of the
                <strong>same</strong> store only touches weight/setting/formula/active for
                <code>isLocaleScoped=true</code> metrics — the rest are already identical across that
                store's own locales.
            </p>

            <form method="get" class="form-inline" style="margin-bottom: 15px;">
                <label for="sourceStoreName">{{ 'Source store' | trans }}</label>
                <select name="sourceStoreName" id="sourceStoreName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == sourceStoreName %}selected="selected"{% endif %}>{{ store }}</option>
                    {% endfor %}
                </select>
                <label for="sourceLocaleName" style="margin-left: 10px;">{{ 'Source locale' | trans }}</label>
                <select name="sourceLocaleName" id="sourceLocaleName" class="form-control" onchange="this.form.submit()">
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == sourceLocaleName %}selected="selected"{% endif %}>{{ locale }}</option>
                    {% endfor %}
                </select>

                <span style="margin-left: 15px; margin-right: 15px;">&rarr;</span>

                <label for="targetStoreName">{{ 'Target store' | trans }}</label>
                <select name="targetStoreName" id="targetStoreName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == targetStoreName %}selected="selected"{% endif %}>{{ store }}</option>
                    {% endfor %}
                </select>
                <label for="targetLocaleName" style="margin-left: 10px;">{{ 'Target locale' | trans }}</label>
                <select name="targetLocaleName" id="targetLocaleName" class="form-control" onchange="this.form.submit()">
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == targetLocaleName %}selected="selected"{% endif %}>{{ locale }}</option>
                    {% endfor %}
                </select>
            </form>

            {% if sourceStoreName == targetStoreName and sourceLocaleName == targetLocaleName %}
                <div class="alert alert-warning">Source and target scope must be different.</div>
            {% endif %}

            {% if hasTargetData %}
                <div class="alert alert-warning">
                    {{ targetStoreName }}/{{ targetLocaleName }} — or another locale of {{ targetStoreName }}
                    that a store-only field in this copy would also apply to — already has saved
                    configuration. Copying or locking will do nothing unless you check "Overwrite existing
                    target configuration" below.
                </div>
            {% endif %}

            <p><strong>{{ 'This will copy:' | trans }}</strong></p>
            {% if fullScopeCopyPreview.metricWeights is empty and fullScopeCopyPreview.settings is empty and fullScopeCopyPreview.storeConfigMetrics is empty %}
                <p class="text-muted">{{ sourceStoreName }}/{{ sourceLocaleName }} has no explicitly saved configuration — nothing to copy yet.</p>
            {% else %}
                <table class="table table-condensed" style="max-width: 700px;">
                    <thead>
                        <tr>
                            <th>{{ 'Field' | trans }}</th>
                            <th>{{ 'Value' | trans }}</th>
                            <th>{{ 'Kept in sync by Lock?' | trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for metricName, weight in fullScopeCopyPreview.metricWeights %}
                            <tr>
                                <td>{{ 'Weight' | trans }} — {{ metricName }}</td>
                                <td>{{ weight }}</td>
                                <td>{{ 'Yes' | trans }}</td>
                            </tr>
                        {% endfor %}
                        {% for label, value in fullScopeCopyPreview.settings %}
                            <tr>
                                <td>{{ label | trans }}</td>
                                <td>{{ value }}</td>
                                <td>{{ 'Yes' | trans }}</td>
                            </tr>
                        {% endfor %}
                        {% for metricName, metric in fullScopeCopyPreview.storeConfigMetrics %}
                            <tr>
                                <td>{{ 'Formula' | trans }} — {{ metricName }}</td>
                                <td><code>{{ metric.formula }}</code></td>
                                <td>{{ 'No — one-off only' | trans }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Active' | trans }} — {{ metricName }}</td>
                                <td>{{ (metric.isActive ? 'Yes' : 'No') | trans }}</td>
                                <td>{{ 'No — one-off only' | trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="text-muted">
                    "Kept in sync by Lock" means the daily scope-copy-sync cron keeps re-applying that row
                    for as long as an active lock covers this pair. Formula/active are only ever written
                    once — at "Copy now" time, or at the moment a lock is first created — never re-synced
                    afterwards, since formula tuning changes far less often than weight.
                </p>
            {% endif %}

            {{ form_start(copyForm, {'action': '/search-ranking-gui/scope-copy-run?sourceStoreName=' ~ sourceStoreName ~ '&sourceLocaleName=' ~ sourceLocaleName ~ '&targetStoreName=' ~ targetStoreName ~ '&targetLocaleName=' ~ targetLocaleName, 'attr': {'class': 'd-inline-block', 'style': 'margin-right: 15px;'}}) }}
                {{ form_widget(copyForm.mode) }}
                {{ form_widget(copyForm.confirmOverwrite) }}
                {{ form_rest(copyForm) }}
                <button type="submit" class="btn btn-primary" style="margin-left: 10px;">{{ 'Copy now' | trans }}</button>
            {{ form_end(copyForm) }}

            {{ form_start(lockForm, {'action': '/search-ranking-gui/scope-copy-lock?sourceStoreName=' ~ sourceStoreName ~ '&sourceLocaleName=' ~ sourceLocaleName ~ '&targetStoreName=' ~ targetStoreName ~ '&targetLocaleName=' ~ targetLocaleName, 'attr': {'class': 'd-inline-block'}}) }}
                {{ form_widget(lockForm.confirmOverwrite) }}
                {{ form_rest(lockForm) }}
                <button type="submit" class="btn btn-success" style="margin-left: 10px;">{{ 'Lock (sync weight/setting daily)' | trans }}</button>
            {{ form_end(lockForm) }}
        {% endblock %}
    {% endembed %}

    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Active locks' } %}
        {% block widget_content %}
            {% if activeLocks is empty %}
                <p>No active locks.</p>
            {% else %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'Source' | trans }}</th>
                            <th>{{ 'Target' | trans }}</th>
                            <th>{{ 'Locked since' | trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for lock in activeLocks %}
                            <tr>
                                <td>{{ lock.sourceStoreName }}/{{ lock.sourceLocaleName }}</td>
                                <td>{{ lock.targetStoreName }}/{{ lock.targetLocaleName }}</td>
                                <td>{{ lock.createdAt ? lock.createdAt | date('Y-m-d H:i') : '—' }}</td>
                                <td>
                                    {% set unlockForm = unlockFormsByIdScopeCopyLock[lock.idSearchRankingScopeCopyLock] %}
                                    {{ form_start(unlockForm, {'action': '/search-ranking-gui/scope-copy-unlock?idSearchRankingScopeCopyLock=' ~ lock.idSearchRankingScopeCopyLock, 'attr': {'class': 'd-inline-block'}}) }}
                                        <button type="submit" class="btn btn-xs btn-danger">{{ 'Unlock' | trans }}</button>
                                    {{ form_end(unlockForm) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
