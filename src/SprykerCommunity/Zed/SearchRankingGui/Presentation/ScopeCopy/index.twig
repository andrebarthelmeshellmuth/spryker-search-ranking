{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Scope Copy' %}
{% block section_title %}{{ widget_title | trans }}{% endblock %}

{% block action %}
    {{ backActionButton('/search-ranking-gui', 'Back to Metrics' | trans) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Copy configuration between store/locale scopes' } %}
        {% block widget_content %}
            <p>
                Copies every metric weight and setting explicitly saved for the source scope onto the target
                scope — a starting point for a newly expanded market, not a substitute for its own real data.
                Product-level metrics are never copied; a freshly bootstrapped market still shows its own
                honest gaps.
            </p>

            <form method="get" class="form-inline" style="margin-bottom: 15px;">
                <label for="sourceStoreName">{{ 'Source store' | trans }}</label>
                <select name="sourceStoreName" id="sourceStoreName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == sourceStoreName %}selected="selected"{% endif %}>{{ store }}</option>
                    {% endfor %}
                </select>
                <label for="sourceLocaleName" style="margin-left: 10px;">{{ 'Source locale' | trans }}</label>
                <select name="sourceLocaleName" id="sourceLocaleName" class="form-control" onchange="this.form.submit()">
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == sourceLocaleName %}selected="selected"{% endif %}>{{ locale }}</option>
                    {% endfor %}
                </select>

                <span style="margin-left: 15px; margin-right: 15px;">&rarr;</span>

                <label for="targetStoreName">{{ 'Target store' | trans }}</label>
                <select name="targetStoreName" id="targetStoreName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == targetStoreName %}selected="selected"{% endif %}>{{ store }}</option>
                    {% endfor %}
                </select>
                <label for="targetLocaleName" style="margin-left: 10px;">{{ 'Target locale' | trans }}</label>
                <select name="targetLocaleName" id="targetLocaleName" class="form-control" onchange="this.form.submit()">
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == targetLocaleName %}selected="selected"{% endif %}>{{ locale }}</option>
                    {% endfor %}
                </select>

                {# Carried through unchanged so submitting THIS form doesn't reset the independent
                   "Sync store configuration" widget's own picker below. #}
                <input type="hidden" name="syncSourceStoreName" value="{{ syncSourceStoreName }}">
                <input type="hidden" name="syncTargetStoreName" value="{{ syncTargetStoreName }}">
            </form>

            {% if sourceStoreName == targetStoreName and sourceLocaleName == targetLocaleName %}
                <div class="alert alert-warning">Source and target scope must be different.</div>
            {% endif %}

            {% if hasTargetData %}
                <div class="alert alert-warning">
                    {{ targetStoreName }}/{{ targetLocaleName }} — or another locale of {{ targetStoreName }}
                    that a store-only metric in this copy would also apply to — already has saved
                    configuration. Copying or locking will do nothing unless you check "Overwrite existing
                    target configuration" below.
                </div>
            {% endif %}

            <p><strong>{{ 'This will copy:' | trans }}</strong></p>
            {% if scopeCopyPreview.metricWeights is empty and scopeCopyPreview.settings is empty %}
                <p class="text-muted">{{ sourceStoreName }}/{{ sourceLocaleName }} has no explicitly saved weight or setting — nothing to copy yet.</p>
            {% else %}
                <table class="table table-condensed" style="max-width: 500px;">
                    <tbody>
                        {% for metricName, weight in scopeCopyPreview.metricWeights %}
                            <tr>
                                <td>{{ 'Weight' | trans }} — {{ metricName }}</td>
                                <td>{{ weight }}</td>
                            </tr>
                        {% endfor %}
                        {% for label, value in scopeCopyPreview.settings %}
                            <tr>
                                <td>{{ label | trans }}</td>
                                <td>{{ value }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {{ form_start(copyForm, {'action': '/search-ranking-gui/scope-copy-run?sourceStoreName=' ~ sourceStoreName ~ '&sourceLocaleName=' ~ sourceLocaleName ~ '&targetStoreName=' ~ targetStoreName ~ '&targetLocaleName=' ~ targetLocaleName ~ '&syncSourceStoreName=' ~ syncSourceStoreName ~ '&syncTargetStoreName=' ~ syncTargetStoreName, 'attr': {'class': 'd-inline-block', 'style': 'margin-right: 15px;'}}) }}
                {{ form_widget(copyForm.confirmOverwrite) }}
                {{ form_rest(copyForm) }}
                <button type="submit" class="btn btn-primary" style="margin-left: 10px;">{{ 'Copy now' | trans }}</button>
            {{ form_end(copyForm) }}

            {{ form_start(lockForm, {'action': '/search-ranking-gui/scope-copy-lock?sourceStoreName=' ~ sourceStoreName ~ '&sourceLocaleName=' ~ sourceLocaleName ~ '&targetStoreName=' ~ targetStoreName ~ '&targetLocaleName=' ~ targetLocaleName ~ '&syncSourceStoreName=' ~ syncSourceStoreName ~ '&syncTargetStoreName=' ~ syncTargetStoreName, 'attr': {'class': 'd-inline-block'}}) }}
                {{ form_widget(lockForm.confirmOverwrite) }}
                {{ form_rest(lockForm) }}
                <button type="submit" class="btn btn-success" style="margin-left: 10px;">{{ 'Lock (sync daily)' | trans }}</button>
            {{ form_end(lockForm) }}
        {% endblock %}
    {% endembed %}

    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Sync store configuration (formula, active flag, curve shape)' } %}
        {% block widget_content %}
            <p>
                Formula/active/curve-shape are store-wide, not per-locale (see the Metrics page's own note) —
                this syncs them from the source STORE to the target STORE below, independently of the
                store/locale pickers above. One-off only — there is no daily-synced lock for this action.
            </p>

            <form method="get" class="form-inline" style="margin-bottom: 15px;">
                <label for="syncSourceStoreName">{{ 'Source store' | trans }}</label>
                <select name="syncSourceStoreName" id="syncSourceStoreName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == syncSourceStoreName %}selected="selected"{% endif %}>{{ store }}</option>
                    {% endfor %}
                </select>

                <span style="margin-left: 15px; margin-right: 15px;">&rarr;</span>

                <label for="syncTargetStoreName">{{ 'Target store' | trans }}</label>
                <select name="syncTargetStoreName" id="syncTargetStoreName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == syncTargetStoreName %}selected="selected"{% endif %}>{{ store }}</option>
                    {% endfor %}
                </select>

                {# Carried through unchanged so submitting THIS form doesn't reset the "Copy configuration
                   between store/locale scopes" widget's own picker above. #}
                <input type="hidden" name="sourceStoreName" value="{{ sourceStoreName }}">
                <input type="hidden" name="sourceLocaleName" value="{{ sourceLocaleName }}">
                <input type="hidden" name="targetStoreName" value="{{ targetStoreName }}">
                <input type="hidden" name="targetLocaleName" value="{{ targetLocaleName }}">
            </form>

            {% if syncSourceStoreName == syncTargetStoreName %}
                <div class="alert alert-warning">Source and target store must be different.</div>
            {% endif %}

            {% if hasTargetStoreConfig %}
                <div class="alert alert-warning">
                    {{ syncTargetStoreName }} already has saved store configuration. Syncing will do nothing
                    unless you check "Overwrite existing target store configuration" below.
                </div>
            {% endif %}

            <p><strong>{{ 'This will sync:' | trans }}</strong></p>
            {% if storeConfigPreview.metrics is empty %}
                <p class="text-muted">{{ syncSourceStoreName }} has no explicitly saved formula — nothing to sync yet.</p>
            {% else %}
                <table class="table table-condensed" style="max-width: 700px;">
                    <thead>
                        <tr>
                            <th>{{ 'Metric' | trans }}</th>
                            <th>{{ 'Formula' | trans }}</th>
                            <th>{{ 'Active' | trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for metricName, metric in storeConfigPreview.metrics %}
                            <tr>
                                <td>{{ metricName }}</td>
                                <td><code>{{ metric.formula }}</code></td>
                                <td>{{ (metric.isActive ? 'Yes' : 'No') | trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {{ form_start(storeConfigSyncForm, {'action': '/search-ranking-gui/store-config-sync-run?syncSourceStoreName=' ~ syncSourceStoreName ~ '&syncTargetStoreName=' ~ syncTargetStoreName ~ '&sourceStoreName=' ~ sourceStoreName ~ '&sourceLocaleName=' ~ sourceLocaleName ~ '&targetStoreName=' ~ targetStoreName ~ '&targetLocaleName=' ~ targetLocaleName}) }}
                {{ form_widget(storeConfigSyncForm.mode) }}
                {{ form_widget(storeConfigSyncForm.confirmOverwrite) }}
                {{ form_rest(storeConfigSyncForm) }}
                <button type="submit" class="btn btn-primary" style="margin-top: 10px;">{{ 'Sync now' | trans }}</button>
            {{ form_end(storeConfigSyncForm) }}
        {% endblock %}
    {% endembed %}

    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Active locks' } %}
        {% block widget_content %}
            {% if activeLocks is empty %}
                <p>No active locks.</p>
            {% else %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'Source' | trans }}</th>
                            <th>{{ 'Target' | trans }}</th>
                            <th>{{ 'Locked since' | trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for lock in activeLocks %}
                            <tr>
                                <td>{{ lock.sourceStoreName }}/{{ lock.sourceLocaleName }}</td>
                                <td>{{ lock.targetStoreName }}/{{ lock.targetLocaleName }}</td>
                                <td>{{ lock.createdAt ? lock.createdAt | date('Y-m-d H:i') : '—' }}</td>
                                <td>
                                    {% set unlockForm = unlockFormsByIdScopeCopyLock[lock.idSearchRankingScopeCopyLock] %}
                                    {{ form_start(unlockForm, {'action': '/search-ranking-gui/scope-copy-unlock?idSearchRankingScopeCopyLock=' ~ lock.idSearchRankingScopeCopyLock, 'attr': {'class': 'd-inline-block'}}) }}
                                        <button type="submit" class="btn btn-xs btn-danger">{{ 'Unlock' | trans }}</button>
                                    {{ form_end(unlockForm) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
