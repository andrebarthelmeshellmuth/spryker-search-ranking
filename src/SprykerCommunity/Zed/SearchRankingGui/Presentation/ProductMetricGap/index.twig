{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Product Metric Gaps' %}
{% block section_title %}{{ widget_title | trans }}{% endblock %}

{% block action %}
    {{ backActionButton('/search-ranking-gui/product-metric?storeName=' ~ storeName ~ '&localeName=' ~ localeName, 'Back to Product Values' | trans) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Products with no value at all for a business score' } %}
        {% block widget_content %}
            <form method="get" class="form-inline" style="margin-bottom: 15px;">
                <label for="metric">{{ 'Business score' | trans }}</label>
                <select name="metric" id="metric" class="form-control" onchange="this.form.submit()">
                    <option value="" {% if selectedIdSearchRankingMetric is null %}selected="selected"{% endif %}>
                        {{ 'All' | trans }}
                    </option>
                    {% for metric in metrics %}
                        <option value="{{ metric.idSearchRankingMetric }}" {% if metric.idSearchRankingMetric == selectedIdSearchRankingMetric %}selected="selected"{% endif %}>
                            {{ metric.name }}
                        </option>
                    {% endfor %}
                </select>
                <label for="storeName" style="margin-left: 10px;">{{ 'Store' | trans }}</label>
                <select name="storeName" id="storeName" class="form-control" onchange="this.form.submit()">
                    {% for store in stores %}
                        <option value="{{ store }}" {% if store == storeName %}selected="selected"{% endif %}>
                            {{ store }}
                        </option>
                    {% endfor %}
                </select>
                <label for="localeName" style="margin-left: 10px;">{{ 'Locale' | trans }}</label>
                <select name="localeName" id="localeName" class="form-control" onchange="this.form.submit()">
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == localeName %}selected="selected"{% endif %}>
                            {{ locale }}
                        </option>
                    {% endfor %}
                </select>
            </form>
            {{ productMetricGapTable | raw }}
        {% endblock %}
    {% endembed %}
{% endblock %}
